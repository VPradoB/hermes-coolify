# Copy is automatic on first boot: /opt/data/.env
# Fill values in Coolify's persistent volume, not in git.

# LLM provider auth:
# Recommended: migrate /opt/data/auth.json from local Hermes if using OAuth providers.
# Alternative: switch config.yaml model provider and put API key here.
# OPENROUTER_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_KEY=

# Spotify Hermes integration.
# Client ID is not a secret, but keep your own value here on the server.
HERMES_SPOTIFY_CLIENT_ID=
HERMES_SPOTIFY_REDIRECT_URI=http://127.0.0.1:43827/spotify/callback

# Firefly III future integration / webhooks.
FIREFLY_BASE_URL=
FIREFLY_TOKEN=

# Optional API server. Do not expose without a strong key and proxy auth.
# API_SERVER_HOST=0.0.0.0
# API_SERVER_KEY=

# Messaging platform secrets. Prefer Coolify secrets/env UI for these.
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# SLACK_BOT_TOKEN=
